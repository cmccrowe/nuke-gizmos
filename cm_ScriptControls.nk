 addUserKnob {22 enableBatchOnlys l "Enable All" -STARTLINE T "with nuke.root():\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('cm_BatchOnly'):\n            i.knob('disable').setValue(0)\n"}
