 ypos -178
 addUserKnob {20 controls l Controls}
 addUserKnob {26 text_20 l "" +STARTLINE T "   "}
 addUserKnob {26 shotcut l "" +STARTLINE T "<h1>Script Controls</h1>"}
 addUserKnob {26 text_21 l "" +STARTLINE T "   "}
 addUserKnob {26 text_14 l "Reads/Cache:           "}
 addUserKnob {26 text_15 l "" +STARTLINE T "   "}
 addUserKnob {26 text_25 l "" +STARTLINE T "         "}
 addUserKnob {22 reloadReads l "Reload All Reads" -STARTLINE T "import nuke\n\n\"\"\"\nThis module contains functionality of reloading all read nodes in the script.\n:return: None\n\"\"\"\n\ndef reload_all_reads():\n    \"\"\"\n    reloads all read nodes in the script\n    :return: None\n    \"\"\"\n\n\n    for node in nuke.allNodes('Read'):\n        node.knob(\"reload\").execute()\n\n    #nodes = nuke.allNodes()\n \n    #for node in nodes:\n    #   if node.Class() == \"Read\":\n    #       node.knob(\"reload\").execute()\n\nwith nuke.root():\n    reload_all_reads()"}
 addUserKnob {22 clearCache l "Clear All Cache" -STARTLINE T "import nuke\nimport nukescripts\nimport os\n\n#clear all nuke caches\n\ndef clearMyCache():\n    nuke.clearRAMCache()\n    nuke.clearBlinkCache()\n    nuke.clearDiskCache()\n    os.system('drop_caches 3')\n\nwith nuke.root():\n    clearMyCache()"}
 addUserKnob {26 _5 l "" +STARTLINE T "         "}
 addUserKnob {26 text_39 l "Writes:                   "}
 addUserKnob {26 text_40 l "" +STARTLINE T "   "}
 addUserKnob {26 text_16 l "" +STARTLINE T "   "}
 addUserKnob {22 ozWrites -STARTLINE T "write_classes = \[\n    'Write',\n    'DeepWrite',\n    'WriteGeo',\n    'SmartVector',\n    'EddyCacheNode',\n]\n\n\n\nwrite_nodes = \[]\nwith nuke.root():\n    for write_class in write_classes:\n        print(write_class)\n        write_nodes += nuke.allNodes(write_class)\n\n\n\n    for write in write_nodes:\n        print(write.name())\n        panel_open = write.shown()\n        if not panel_open:\n            write.showControlPanel()\n        try:\n            weta_write = write\['weta_write'].getObject().getWidget()\n        except Exception:\n            print('\{\} doesn\\'t have a Weta tab.'.format(write.name()))\n            continue\n        weta_write.context_selector.on_pushButton_context_clicked()\n        weta_write.widgetWasUpdated()\n        if not panel_open:\n            write.hideControlPanel()"}
 addUserKnob {22 python_button_1 l RGB -STARTLINE T "with nuke.root():\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('Write'):\n            i.knob('channels').setValue('rgb')\n"}
 addUserKnob {22 python_button_3 l RGBA -STARTLINE T "with nuke.root():\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('Write'):\n            i.knob('channels').setValue('rgba')\n"}
 addUserKnob {22 setToAll l ALL -STARTLINE T "with nuke.root():\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('Write'):\n            i.knob('channels').setValue('all')\n"}
 addUserKnob {26 text_41 l "" +STARTLINE T "   "}
 addUserKnob {26 text_35 l "Merge Nodes:         "}
 addUserKnob {26 text_36 l "" +STARTLINE T "   "}
 addUserKnob {26 text_38 l "" +STARTLINE T "   "}
 addUserKnob {22 replace_merges l "Replace Merge with mMerge" -STARTLINE T "\n\nimport hydra\n\n\nfrom compcore.nuke_script import script_utils\n\n\n\nmmerge_product = hydra.getProduct('hyref://weta/nuke/mMerge.nukeGizmo')\nmmerge_path = mmerge_product.getVersionByTag(hydra.Published).getLocation()\n\n\n\ndef select_none():\n    nuke.selectAll()\n    nuke.invertSelection()\n\n\n\ndef merge_to_mmerge(merge):\n    select_none()\n    mmerge = nuke.nodePaste(mmerge_path)\n    try:\n        for i in range(mmerge.inputs()):\n            mmerge.setInput(i, None)\n        exclude_knobs = \{'name', 'tile_color', 'also_merge'\}\n        common_knobs = set(merge.knobs()).intersection(mmerge.knobs())\n        knobs_to_copy = common_knobs.difference(exclude_knobs)\n        for knob in knobs_to_copy:\n            mmerge\[knob].fromScript(merge\[knob].toScript())\n    except Exception:\n        nuke.delete(mmerge)\n        return\n    script_utils.replace_node(merge, mmerge, list())\n\n\n\ndef replace_merges():\n    selected_nodes = nuke.selectedNodes()\n    if selected_nodes:\n        merges = \[n for n in selected_nodes if n.Class() == 'Merge2']\n    else:\n        merges = nuke.allNodes('Merge2')\n    for merge in merges:\n        merge_to_mmerge(merge)\n\n\nwith nuke.root():\n    replace_merges()"}
 addUserKnob {22 python_button_2 l "Set Selected B Input" -STARTLINE T "with nuke.root():\n    for i in nuke.selectedNodes():\n            i.knob(\"bbox\").setValue('B')"}
 addUserKnob {26 text_37 l "" +STARTLINE T "   "}
 addUserKnob {26 text_17 l "Camera Properties/Defocus:"}
 addUserKnob {26 text_18 l "" +STARTLINE T "   "}
 addUserKnob {26 text_26 l "" +STARTLINE T "         "}
 addUserKnob {22 openCamera l "Open 'Camera1'" -STARTLINE T "#Opens shot camera's properties panel\n\n\nwith nuke.root():\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('Camera1'):\n            nuke.show(i)"}
 addUserKnob {26 text_30 l "" -STARTLINE T "   "}
 addUserKnob {3 radius l "max radius" -STARTLINE}
 radius 64
 addUserKnob {22 setMaxRadius l Set -STARTLINE T "sc=nuke.thisNode()\nmaxb=sc.knob('radius').getValue()\nwith nuke.root():\n    for i in nuke.allNodes('DefocusElement'):\n        i.knob('maxiumRadius').setValue(maxb)"}
 addUserKnob {26 text_19 l "" +STARTLINE T "   "}
 addUserKnob {26 text_2 l "cm_Switches:        "}
 addUserKnob {26 space l "" +STARTLINE T "   "}
 addUserKnob {26 text l "" +STARTLINE T State:}
 addUserKnob {22 offBtn l "<p style=\"color:#878787\">OFF</p>" -STARTLINE T "def hex_color_to_int(hexValue):\n    return int(hexValue+'00', 16)\n\n\n\n\n# define variables–––\nn = nuke.thisNode()\nk = n\['label']\nc = n\['tile_color']\noffKnob = nuke.thisKnob()\n\n\n\n\n#Switch to Off State\nk.setValue(\"OFF\")\nc.setValue(hex_color_to_int(\"eb4034\"))\nn.knob('onBtn').setLabel(\"\"\"<p style=\"color:#878787\">ON</p>\"\"\")\n\n\n\n\nwith nuke.root():\n    n = nuke.thisNode()\n    offKnob = nuke.thisKnob()\n    offKnob.setLabel(\"\"\"<p style=\"color:#eb4034\">OFF</p>\"\"\")\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('OnOff_Switch'):\n            i\['tile_color'].setValue(hex_color_to_int(\"eb4034\"))\n            i.knob('label').setValue(\"OFF\")\n            i.knob('off_btn').setLabel(\"\"\"<p style=\"color:#eb4034\">OFF</p>\"\"\")\n            i.knob('on_btn').setLabel(\"\"\"<p style=\"color:#878787\">ON</p>\"\"\")\n    group_nodes = \[node for node in nuke.allNodes() if node.Class() == 'Group']\n    for group in group_nodes:\n        switch_nodes = \[node for node in nuke.allNodes(recurseGroups=True) if node.Class() == 'Switch']\n        for i in switch_nodes:\n            if i\['name'].value().startswith('cm_Switch'):           \n                i.knob('which').setValue(0)\n                i\['tile_color'].setValue(hex_color_to_int(\"eb4034\"))"}
 addUserKnob {22 onBtn l "<p style=\"color:#34eb6e\">ON</p>" -STARTLINE T "def hex_color_to_int(hexValue):\n    return int(hexValue+'00', 16)\n\n\n\n\n# define variables–––\nn = nuke.thisNode()\nk = n\['label']\nc = n\['tile_color']\nonKnob = nuke.thisKnob()\n\n\n\n\n#Switch to On State\nk.setValue(\"ON\")\nc.setValue(hex_color_to_int(\"34eb6e\"))\nn.knob('offBtn').setLabel(\"\"\"<p style=\"color:#878787\">OFF</p>\"\"\")\n\n\n\n\nwith nuke.root():\n    n = nuke.thisNode()\n    onKnob = nuke.thisKnob()\n    onKnob.setLabel(\"\"\"<p style=\"color:#34eb6e\">ON</p>\"\"\")\n    for i in nuke.allNodes():\n        if i\['name'].value().startswith('OnOff_Switch'):\n            i\['tile_color'].setValue(hex_color_to_int(\"34eb6e\"))\n            i.knob('label').setValue(\"ON\")\n            i.knob('on_btn').setLabel(\"\"\"<p style=\"color:#34eb6e\">ON</p>\"\"\")\n            i.knob('off_btn').setLabel(\"\"\"<p style=\"color:#878787\">OFF</p>\"\"\")\n    group_nodes = \[node for node in nuke.allNodes() if node.Class() == 'Group']\n    for group in group_nodes:\n        switch_nodes = \[node for node in nuke.allNodes(recurseGroups=True) if node.Class() == 'Switch']\n        for i in switch_nodes:\n            if i\['name'].value().startswith('cm_Switch'):           \n                i.knob('which').setValue(1)\n                i\['tile_color'].setValue(hex_color_to_int(\"34eb6e\"))"}
 addUserKnob {26 space2 l "" +STARTLINE T "  "}
 addUserKnob {26 sapce6 l "" +STARTLINE T "   "}
